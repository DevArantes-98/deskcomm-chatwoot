            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar original na Evolution": {
      "main": [
        [
          {
            "node": "Aplicar edição no Chatwoot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
